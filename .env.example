# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/codeforge
APP_ORIGIN=http://localhost:5173
# Replace with at least 32 random characters before starting the API.
SESSION_SECRET=
# Set to 1 only behind your own single reverse proxy (production HTTPS).
TRUST_PROXY=0
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=codeforge
# The separate worker reads REDIS_URL/REDIS_PREFIX from its process environment,
# with the same defaults above. It does not load this file or API secrets.
# Optional AI assistant configuration, read only by the API server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
