# Create /opt/codeforge/shared/production.env manually; chmod 600. Never commit it.
APP_DOMAIN=codeforge.example.com
SESSION_SECRET=
# Use separate random hexadecimal passwords (e.g. openssl rand -hex 32).
# Hex avoids URL escaping in the MongoDB/Redis connection strings.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
REDIS_PREFIX=codeforge_prod
# On the VPS: stat -c '%g' /var/run/docker.sock
DOCKER_GID=
# Optional; only the API receives these settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# IMAGE_REPOSITORY and IMAGE_TAG are supplied by the deployment script, not this file.
